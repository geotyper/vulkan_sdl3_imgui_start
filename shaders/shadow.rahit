#version 460 core
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require

#include "../src/shared_with_shaders.h"

layout(location = SWS_LOC2_SHADOW_RAY) rayPayloadInEXT ShadowPayload shadow;

void main()
{
    // Unpack the unique instance ID
    uint packedID = gl_InstanceCustomIndexEXT;
    uint instanceID = packedID >> 8;

    // Check if the shadow ray has hit our glass sphere (instanceID 0)
    if (instanceID == 0) {
       // This is the crucial fix.
       // It tells the ray tracer to ignore this intersection and continue
       // searching for something that would actually block the light.
       ignoreIntersectionEXT;
       return;
    }

    // If the ray hits any other object (like a cubelet), it IS blocked.
    shadow.blocked = true;
    terminateRayEXT; // We can also terminate here to save a little performance.
}

