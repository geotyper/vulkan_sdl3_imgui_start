#version 460 core
#extension GL_EXT_ray_tracing          : enable
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require

#include "../src/shared_with_shaders.h"

layout(set = SWS_SCENE_AS_SET, binding = SWS_SCENE_AS_BINDING)
uniform accelerationStructureEXT topLevelAS;

layout(set = SWS_RESULT_IMAGE_SET, binding = SWS_RESULT_IMAGE_BINDING, rgba8)
uniform image2D accumImage;

layout(set = SWS_CAMERA_SET, binding = SWS_CAMERA_BINDING)
uniform CameraUBO { mat4 invView; mat4 invProj; } cam;

layout(set = SWS_SCENE_AS_SET, binding = SWS_UNIFORM_DATA_BINDING)
uniform UniformBlock { UniformData uni; } U;

layout(location = SWS_LOC_PRIMARY_RAY) rayPayloadEXT RadiancePayload prd;

void main() {
    vec2 pix = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    vec2 res = vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = (pix / res) * 2.0 - 1.0;

    vec4 nearP = cam.invProj * vec4(ndc, 0.0, 1.0);
    vec4 farP  = cam.invProj * vec4(ndc, 1.0, 1.0);
    nearP /= nearP.w; farP /= farP.w;

    vec3 ro = (cam.invView * vec4(0,0,0,1)).xyz;
    vec3 p0 = (cam.invView * vec4(nearP.xyz,1)).xyz;
    vec3 p1 = (cam.invView * vec4(farP.xyz,1)).xyz;
    vec3 rd = normalize(p1 - p0);

    prd.color = vec3(0.0);

    traceRayEXT(
        topLevelAS,
        gl_RayFlagsOpaqueEXT,
        0xFF,
        HIT_PRIMARY,          // sbtRecordOffset (your HIT_* from header)
        SWS_NUM_GROUPS,       // sbtRecordStride
        MISS_PRIMARY,         // missIndex
        ro, 0.001, rd, 1e32,
        SWS_LOC_PRIMARY_RAY
    );

    imageStore(accumImage, ivec2(gl_LaunchIDEXT.xy), vec4(prd.color, 1.0));
}

