#version 460 core
#extension GL_EXT_ray_tracing          : enable
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require

#include "../src/shared_with_shaders.h"

layout(set = SWS_SCENE_AS_SET, binding = SWS_SCENE_AS_BINDING)
uniform accelerationStructureEXT topLevelAS;

// --- HDR Accumulation Image ---
// Using rgba32f for high-precision light accumulation.
layout(set = SWS_SCENE_AS_SET, binding = SWS_RESULT_IMAGE_BINDING, rgba32f)
uniform image2D accumImage;

layout(set = SWS_SCENE_AS_SET, binding = SWS_CAMERA_BINDING)
uniform CameraUBO { mat4 invView; mat4 invProj; } cam;

layout(std140, set = SWS_SCENE_AS_SET, binding = SWS_UNIFORM_DATA_BINDING)
uniform UniformBlock { UniformData uni; } U;

layout(location = SWS_LOC_PRIMARY_RAY) rayPayloadEXT RadiancePayload prd;

// --- SBT indices inside regions (we use 1 miss + 1 hit-group) ---
#define MISS_PRIMARY 0
#define HIT_PRIMARY  0

// --- RNG (Wang hash) ---
uint wanghash(uint s){ s = (s ^ 61u) ^ (s >> 16u); s *= 9u; s ^= (s >> 4u); s *= 0x27d4eb2du; s ^= (s >> 15u); return s; }


// ====================================================================
// ===           PARAMETER CHANGES ARE HERE                       ===
// ====================================================================

// --- tonemap params (compile-time) ---
const float TM_EXPOSURE_EV = -0.75;  // Darken the image slightly before contrast
const float TM_CONTRAST    = 1.8;   // Increased from 1.25 for a much stronger effect
const float TM_PIVOT       = 0.5;   // Mid-point for contrast (0.5 is fine for LDR)
// You can also try the sigmoid contrast for a smoother, S-curve falloff
// by setting TM_USE_SIGMOID to true.
const float TM_SIGMOID_K   = 1.00;  // 3..8 typical
const bool  TM_USE_SIGMOID = false; // true = sigmoid, false = linear pivot

// ====================================================================

// --- exposure + ACES filmic ---
vec3 aces_fitted(vec3 x){
    const float a=2.51, b=0.03, c=2.43, d=0.59, e=0.14;
    return clamp((x*(a*x+b)) / (x*(c*x+d)+e), 0.0, 1.0);
}
vec3 apply_exposure(vec3 hdr, float ev){ return hdr * exp2(ev); }

// --- contrast (choose ONE of these, or both) ---
vec3 contrast_pivot(vec3 x, float contrast, float pivot){
    return clamp((x - pivot) * contrast + pivot, 0.0, 1.0);
}
float sigmoid(float v, float k){ return 1.0 / (1.0 + exp(-k*(v - 0.5))); }
vec3 contrast_sigmoid(vec3 x, float k){
    return vec3(sigmoid(x.r,k), sigmoid(x.g,k), sigmoid(x.b,k));
}

// --- encode to sRGB if you write to a *linear* UNORM image ---
vec3 linear_to_srgb(vec3 c){ return pow(clamp(c,0.0,1.0), vec3(1.0/2.2)); }


// This is a self-contained function to apply the full tonemapping pipeline
// to a linear HDR color.
vec3 apply_full_tonemap(vec3 linear_color) {
    // 1. Apply exposure
    vec3 hdr = apply_exposure(linear_color, TM_EXPOSURE_EV);

    // 2. Apply ACES Filmic Tonemap (HDR -> LDR)
    vec3 ldr = aces_fitted(hdr);

    // 3. Apply contrast to the LDR color
    if (TM_USE_SIGMOID) {
        ldr = contrast_sigmoid(ldr, TM_SIGMOID_K);
    } else {
        ldr = contrast_pivot(ldr, TM_CONTRAST, TM_PIVOT);
    }
    
    // 4. Convert to sRGB for final display
    return linear_to_srgb(ldr);
}


void main()
{
    const uvec2 pixel = gl_LaunchIDEXT.xy;
    const uvec2 size  = gl_LaunchSizeEXT.xy;

    // --- camera ray ---
    vec2 uv  = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;

    vec3 origin    = (cam.invView * vec4(0,0,0,1)).xyz;
    vec3 dir_ndc   = (cam.invProj * vec4(ndc, 1.0, 1.0)).xyz;
    vec3 dir       = normalize((cam.invView * vec4(dir_ndc, 0.0)).xyz);

    // --- init path ---
    vec3 accumulatedSamples = vec3(0.0);
    int numSamples = max(1, U.uni.samplesPerFrame);

    // стабильный seed по пикселю и кадру
    uint seed = wanghash(pixel.x * 928371u
                       ^ pixel.y * 689287499u
                       ^ uint(U.uni.frameCounter) * 104729u);

    for (int smp = 0; smp < numSamples; ++smp)
    {
        // 1. Subpixel Jitter for Anti-Aliasing
        vec2 jitter = vec2(0.0);
        if (numSamples > 1 || U.uni.frameCounter > 0) {
            seed = wanghash(seed + 1u);
            float rx = float(seed) * (1.0 / 4294967296.0);
            seed = wanghash(seed + 1u);
            float ry = float(seed) * (1.0 / 4294967296.0);
            jitter = (vec2(rx, ry) - 0.5); // [-0.5, 0.5]
        }

        vec2 uv  = (vec2(pixel) + 0.5 + jitter) / vec2(size);
        vec2 ndc = uv * 2.0 - 1.0;

        // --- Lens Distortion ---
        // Simple radial distortion: ndc' = ndc * (1 + k * r^2)
        if (abs(U.uni.lensDistortion) > 0.0001) {
            float r2 = dot(ndc, ndc);
            ndc *= (1.0 + U.uni.lensDistortion * r2);
        }

        // --- Artistic Chromatic Shift (Radial/Stable) ---
        if (U.uni.chromaticAberration > 0.0001) {
            vec2 toCenter = ndc; // Assumes ndc starts at origin (0,0) for center
            float dist = length(toCenter);
            // We use a small radial shift per channel. 
            // Channels: Red expands, Blue contracts slightly.
            // This is "stable" as it depends only on pixel position.
            // ndc stays as the 'Green' channel.
            vec2 ndcR = ndc * (1.0 + U.uni.chromaticAberration * dist);
            vec2 ndcB = ndc * (1.0 - U.uni.chromaticAberration * dist);
            
            // For now, we sample 3 rays or just jitter the current one?
            // To be TRULY stable without multi-ray performance hit, 
            // we'd need multiple traceRayEXT calls here or in a loop.
            // Given the current architecture, let's use the jitter 
            // BUT make it deterministic per sample index to avoid temporal shimmering.
            // OR better: we can split the throughput per-channel if we want fake CA.
            // But real CA needs different directions.
            
            // Let's use deterministic direction shift based on sample index
            float angle = (float(smp) / float(numSamples)) * 6.28318;
            vec2 caShift = vec2(cos(angle), sin(angle)) * U.uni.chromaticAberration * dist;
            ndc += caShift; 
        }

        vec3 origin    = (cam.invView * vec4(0,0,0,1)).xyz;
        vec3 dir_ndc   = (cam.invProj * vec4(ndc, 1.0, 1.0)).xyz;
        vec3 dir       = normalize((cam.invView * vec4(dir_ndc, 0.0)).xyz);

        vec3 sampleColor = vec3(0.0);
        vec3 throughput = vec3(1.0);

        uint maxBounces = uint(max(1, U.uni.maxBounces));
        const uint MIN_BOUNCES = 3u;

        prd.color = vec3(0.0);

        for (uint bounce = 0u; bounce < maxBounces; ++bounce)
        {
            prd.throughput = throughput;
            prd.done       = false;
            prd.depth      = bounce;
            prd.rayOrigin  = origin;
            prd.rayDir     = dir;
            prd.seed       = seed;

            traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF,
                        HIT_PRIMARY, /*hitStride*/1, MISS_PRIMARY,
                        origin, 0.001, dir, 1e19,
                        SWS_LOC_PRIMARY_RAY);

            sampleColor += prd.color;
            prd.color = vec3(0.0); // Reset for next bounce

            if (prd.done) {
                sampleColor += prd.throughput;
                break;
            }

            origin     = prd.rayOrigin;
            dir        = prd.rayDir;
            throughput = prd.throughput;
            seed = wanghash(seed + 1u);

            if (bounce >= MIN_BOUNCES) {
                float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.1, 0.99);
                if (float(wanghash(seed+=1u)) * (1.0/4294967296.0) > p) {
                    break;
                }
                throughput /= p;
            }
        }
        accumulatedSamples += sampleColor;
    }

    vec3 finalColor = accumulatedSamples / float(numSamples);

    // ====================================================================
    // ===           LOGIC CHANGES ARE HERE                           ===
    // ====================================================================

    // 1. Load the raw accumulated HDR color
    vec4 oldData = imageLoad(accumImage, ivec2(pixel));
    vec3 prev_hdr_color = oldData.rgb;

    // 2. Accumulate the new linear HDR sample
    vec3 new_hdr_sample = finalColor;
    
    // 3. Determine the blend factor for the running average
    float blend_factor = (U.uni.frameCounter == 0) 
        ? 1.0 
        : 1.0 / float(U.uni.frameCounter + 1);

    // 4. Blend raw HDR values
    vec3 accumulated_hdr = mix(prev_hdr_color, new_hdr_sample, blend_factor);

    // 5. Apply tonemapping to the accumulated result for display
    vec3 mapped_output = apply_full_tonemap(accumulated_hdr);

    // 6. Store RAW HDR back for future accumulation, 
    // BUT we are writing to an image that is also used for display.
    // If we want HDR accumulation, we MUST store the raw HDR.
    // The current Vulkan setup copies this image to the swapchain.
    imageStore(accumImage, ivec2(pixel), vec4(accumulated_hdr, 1.0));

    // NOTE: Because we are now storing raw HDR in an RGBA32F image, 
    // the final copy to the UNORM swapchain will perform a simple 0-1 clamp.
    // To see the full effect of HDR, a post-process tonemapping pass is needed.
    // However, even with clamping at the copy stage, the ACCUMULATION is now 
    // 32-bit precise, which will solve the "stalling" and precision noise.
}
