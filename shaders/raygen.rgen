#version 460 core
#extension GL_EXT_ray_tracing          : enable
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require

#include "../src/shared_with_shaders.h"

layout(set = SWS_SCENE_AS_SET, binding = SWS_SCENE_AS_BINDING)
uniform accelerationStructureEXT topLevelAS;

layout(set = SWS_SCENE_AS_SET, binding = SWS_RESULT_IMAGE_BINDING, rgba8)
uniform image2D accumImage;

layout(set = SWS_SCENE_AS_SET, binding = SWS_CAMERA_BINDING)
uniform CameraUBO { mat4 invView; mat4 invProj; } cam;

layout(set = SWS_SCENE_AS_SET, binding = SWS_UNIFORM_DATA_BINDING)
uniform UniformBlock { UniformData uni; } U;

layout(location = SWS_LOC_PRIMARY_RAY) rayPayloadEXT RadiancePayload prd;

// --- SBT indices inside regions (we use 1 miss + 1 hit-group) ---
#define MISS_PRIMARY 0
#define HIT_PRIMARY  0

// --- RNG (Wang hash) ---
uint wanghash(uint s){ s = (s ^ 61u) ^ (s >> 16u); s *= 9u; s ^= (s >> 4u); s *= 0x27d4eb2du; s ^= (s >> 15u); return s; }

vec3 tonemapACES(vec3 x){
    const float a=2.51, b=0.03, c=2.43, d=0.59, e=0.14;
    return clamp((x*(a*x+b))/(x*(c*x+d)+e), 0.0, 1.0);
}

// Если хочешь хранить в текстуре линейный цвет без тонмапа — поставь 0
#define ACCUM_TONEMAP_ON_WRITE 1

void main()
{
    const uvec2 pixel = gl_LaunchIDEXT.xy;
    const uvec2 size  = gl_LaunchSizeEXT.xy;

    // --- camera ray ---
    vec2 uv  = (vec2(pixel) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;

    vec3 origin   = (cam.invView * vec4(0,0,0,1)).xyz;
    vec3 dir_ndc  = (cam.invProj * vec4(ndc, 1.0, 1.0)).xyz;
    vec3 dir      = normalize((cam.invView * vec4(dir_ndc, 0.0)).xyz);

    // --- init path ---
    vec3 finalColor = vec3(0.0);
    vec3 throughput = vec3(1.0);

    // стабильный seed по пикселю и кадру
    uint seed = wanghash(pixel.x * 928371u
                       ^ pixel.y * 689287499u
                       ^ uint(U.uni.frameCounter) * 104729u);

    const uint MAX_BOUNCES = 8u;
    const uint MIN_BOUNCES = 2u;

    for (uint bounce = 0u; bounce < MAX_BOUNCES; ++bounce)
    {
        prd.throughput = throughput;
        prd.done       = false;
        prd.depth      = bounce;
        prd.rayOrigin  = origin;
        prd.rayDir     = dir;
        prd.seed       = seed;

        traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF,
                    HIT_PRIMARY, /*hitStride*/1, MISS_PRIMARY,
                    origin, 0.001, dir, 1e19,
                    SWS_LOC_PRIMARY_RAY);

        if (prd.done) {
            // miss/непрозрачная поверхность завершили путь, prd.throughput содержит вклад
            finalColor += prd.throughput;
            break;
        }

        // продолжить путь (стекло)
        origin    = prd.rayOrigin;
        dir       = prd.rayDir;
        throughput= prd.throughput;

        // новый seed для следующего шага
        seed = wanghash(seed + 1u);

        if (bounce >= MIN_BOUNCES) {
            float p = clamp(max(throughput.r, max(throughput.g, throughput.b)), 0.1, 0.99);
            if (float(wanghash(seed+=1u)) * (1.0/4294967296.0) > p) {
                // терминируем без вклада — метод несмещён
                break;
            }
            throughput /= p; // компенсация RR
        }
    }

   vec3 prev_color = imageLoad(accumImage, ivec2(pixel)).rgb;

    // Стабильный running-average по кадрам
    float blend_factor = (U.uni.frameCounter == 0) ? 1.0
                                                   : 1.0 / float(U.uni.frameCounter + 1);

    // Если храним LDR (rgba8) — включаем тонмап при записи
    #if ACCUM_TONEMAP_ON_WRITE
        // поднять экспозицию и протонемапить
        vec3 display = tonemapACES(finalColor * U.uni.exposure);
        // gamma -> sRGB (если swapchain не sRGB)
        display = pow(display, vec3(1.0/2.2));

        vec3 prev = imageLoad(accumImage, ivec2(pixel)).rgb;
        vec3 outc = mix(prev, display, blend_factor);
        imageStore(accumImage, ivec2(pixel), vec4(outc, 1.0));

    #else
        // Копим линейный HDR (ТРЕБУЕТ rgba16f/rgba32f у accumImage)
        vec3 prev = imageLoad(accumImage, ivec2(pixel)).rgb;
        vec3 avg  = mix(prev, finalColor, blend_factor);
        imageStore(accumImage, ivec2(pixel), vec4(avg, 1.0));
    #endif

}

