#version 460 core
#extension GL_EXT_ray_tracing : enable
#extension GL_GOOGLE_include_directive : require

#include "../src/shared_with_shaders.h"

layout(location = SWS_LOC_PRIMARY_RAY)
rayPayloadInEXT RadiancePayload prd;

const float MIN_WEIGHT = 0.02;          // когда вклад стал незаметным

float rand(vec2 co){
    return fract(sin(dot(co.xy, vec2(12.9898, 78.233))) * 43758.5453);
}

void main() {
    // Unpack the unique instance ID, just like in the closest-hit shader.
    uint packedID = gl_InstanceCustomIndexEXT;
    uint uniqueInstanceID = packedID >> 8;

    // In our C++ code, the sphere is ID 0, the 26 cubelets are 1-26,
    // so the big frame we added last will be ID 27.
    uint frameInstanceID = 17;

    if (uniqueInstanceID == frameInstanceID) {
        // This is our transparent frame.
        // Set its opacity. 0.0 is fully transparent, 1.0 is fully opaque.
        float opacity = 0.1; // Very transparent

        // If our random number is greater than the opacity, the ray passes through.
        if (rand(gl_LaunchIDEXT.xy) > opacity) {
            // Ignore this intersection and let the ray continue as if it hit nothing.
            ignoreIntersectionEXT;
            return;
        }
        // Otherwise, we do nothing. The intersection is reported to the
        // closest-hit shader, and the object will be rendered.
    }
    // For all other instances (cubelets, sphere), this shader does nothing,
    // so they remain fully opaque.
}
